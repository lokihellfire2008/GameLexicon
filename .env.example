# GameLexicon - example environment variables
# Database (choose one):
# DATABASE_URL=sqlite::memory:?cache=shared
# or use a file:
# DATABASE_URL=sqlite:///C:/Users/YourUser/AppData/Local/GameLexicon/gamelexicon.sqlite?mode=rwc

# IGDB / Twitch API (optional - enables live genres and future metadata)
IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret
